<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#FF0B1A22"
                android:startColor="#FF05070A" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#3300E5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="85%"
                android:centerY="15%"
                android:endColor="#0000E5FF"
                android:gradientRadius="180dp"
                android:startColor="#4400E5FF"
                android:type="radial" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
